# ── Firebase (auth admin + Firestore) — offre gratuite Spark suffisante ──
# Console Firebase > Paramètres du projet > Vos applications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Upload d'images : Cloudinary (offre gratuite, recommandé) ──
# 1. Créez un compte sur cloudinary.com (gratuit, sans carte)
# 2. Settings > Upload > Add upload preset > Signing Mode = "Unsigned"
# 3. Reportez le "Cloud name" et le nom du preset ci-dessous
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=delice-cake

# ── Alternative à Cloudinary : Firebase Storage (nécessite le plan Blaze) ──
# Laisser vide si vous utilisez Cloudinary.
VITE_FIREBASE_STORAGE_BUCKET=
